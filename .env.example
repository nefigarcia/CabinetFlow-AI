# Sample environment variables. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:pass@host:3306/dbname

# ─── AWS / S3 (server-side + upload CLI only) ──────────────────────────
# These are consumed by services/* (cad-service, cnc-service, render-service)
# and by packages/asset-cli. They MUST NOT be prefixed with NEXT_PUBLIC_ —
# doing so would leak credentials into the browser bundle.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=woodcraft-os-files

# ─── Scene Asset CDN (public, browser-safe) ────────────────────────────
# ROOT of the CDN — do NOT include `/scene` in this value. The URL
# resolver adds `scene/<assetKey>` automatically. See
# docs/SCENE_ASSET_PIPELINE.md §1 for the full contract.
#
# Example (CloudFront):  https://d123abc.cloudfront.net
# Example (custom):      https://assets.woodcraft.example
# Example (S3 direct):   https://woodcraft-os-files.s3.us-east-1.amazonaws.com
#
# When UNSET the app uses `/assets` and Next.js serves files from
# `apps/web/public/assets/scene/…` — no AWS required for local dev.
NEXT_PUBLIC_SCENE_ASSET_BASE_URL=

# ─── Web + API URLs ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:3002

# ─── Feature flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_SCENE_ASSETS=true
