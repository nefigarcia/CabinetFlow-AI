generator client {
  provider = "prisma-client-js"
  // Output to root node_modules so all workspace packages can import @prisma/client
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. ORGANIZATIONS
// Top-level multi-tenant boundary. Every data row is scoped by org_id.
// ─────────────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  plan      String   @default("starter") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Phase 2 uses this bag to store `cabinetSystemAssignments`:
  //   { familyRuleIdsByCabinetType: { base?, wall?, ... },
  //     preferredFrontSystemId?, preferredDrawerSystemId? }
  // No new FK columns on organizations for family/front/drawer refs.
  metadata  Json?

  // ── Profile-inheritance defaults (Phase 1 — metadata + readiness
  // only; NOT wired into the geometry compiler). Nullable so an org
  // without a chosen default falls through to hardcoded compiler
  // behavior exactly as today.
  defaultConstructionProfileId String?                 @map("default_construction_profile_id")
  defaultConstructionProfile   ConstructionProfile?    @relation("OrgDefaultConstruction", fields: [defaultConstructionProfileId], references: [id], onDelete: SetNull)
  defaultMaterialProfileId     String?                 @map("default_material_profile_id")
  defaultMaterialProfile       CabinetMaterialProfile? @relation("OrgDefaultMaterial", fields: [defaultMaterialProfileId], references: [id], onDelete: SetNull)
  defaultHardwareProfileId     String?                 @map("default_hardware_profile_id")
  defaultHardwareProfile       HardwareProfile?        @relation("OrgDefaultHardware", fields: [defaultHardwareProfileId], references: [id], onDelete: SetNull)

  users          User[]
  clients        Client[]
  projects       Project[]
  materials      Material[]
  hardware       Hardware[]
  machineProfiles MachineProfile[]
  productionRuns ProductionRun[]

  constructionProfiles     ConstructionProfile[]
  cabinetMaterialProfiles  CabinetMaterialProfile[]
  hardwareProfiles         HardwareProfile[]

  // Phase 2 — cabinet-family / front-system / drawer-system library.
  // Assignments (which rule/system applies where) live in
  // Organization.metadata / Project.metadata / Room.metadata JSON blobs
  // and Cabinet.parameters JSON — no relation columns on those tables.
  cabinetFamilyRules       CabinetFamilyRule[]
  frontSystems             FrontSystem[]
  drawerSystems            DrawerSystem[]

  @@index([defaultConstructionProfileId])
  @@index([defaultMaterialProfileId])
  @@index([defaultHardwareProfileId])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. USERS
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  orgId        String    @map("org_id")
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  // role: owner | admin | designer | viewer
  role         String    @default("designer") @db.VarChar(50)
  // Hashed bcrypt of the refresh token — cleared on logout
  refreshToken String?   @map("refresh_token") @db.Text
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  revisions Revision[]
  quotes    Quote[]

  @@index([orgId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. CLIENTS
// ─────────────────────────────────────────────────────────────────────────────
model Client {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([orgId])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. PROJECTS
// ─────────────────────────────────────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  clientId    String   @map("client_id")
  name        String   @db.VarChar(255)
  description String?  @db.Text
  // status: draft | in_review | approved | in_production | complete
  status      String   @default("draft") @db.VarChar(50)
  metadata    Json?

  // ── Profile-inheritance overrides (Phase 1). Nullable — omitted
  // fields fall through to org defaults via the resolver.
  constructionProfileId String?                 @map("construction_profile_id")
  constructionProfile   ConstructionProfile?    @relation("ProjectConstruction", fields: [constructionProfileId], references: [id], onDelete: SetNull)
  materialProfileId     String?                 @map("material_profile_id")
  materialProfile       CabinetMaterialProfile? @relation("ProjectMaterial", fields: [materialProfileId], references: [id], onDelete: SetNull)
  hardwareProfileId     String?                 @map("hardware_profile_id")
  hardwareProfile       HardwareProfile?        @relation("ProjectHardware", fields: [hardwareProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id])
  rooms          Room[]
  revisions      Revision[]
  productionRuns ProductionRun[]
  quotes         Quote[]

  @@index([orgId])
  @@index([clientId])
  @@index([constructionProfileId])
  @@index([materialProfileId])
  @@index([hardwareProfileId])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. ROOMS
// Represents a physical room/space within a project (e.g. kitchen, bathroom).
// ─────────────────────────────────────────────────────────────────────────────
model Room {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  orgId     String   @map("org_id")
  name      String   @db.VarChar(255)
  // All measurements stored in millimeters as DECIMAL(10,4)
  width     Decimal  @db.Decimal(10, 4)
  height    Decimal  @db.Decimal(10, 4)
  depth     Decimal  @db.Decimal(10, 4)
  metadata  Json?

  // ── Profile-inheritance overrides (Phase 1). Nullable — omitted
  // fields fall through to project → org via the resolver.
  constructionProfileId String?                 @map("construction_profile_id")
  constructionProfile   ConstructionProfile?    @relation("RoomConstruction", fields: [constructionProfileId], references: [id], onDelete: SetNull)
  materialProfileId     String?                 @map("material_profile_id")
  materialProfile       CabinetMaterialProfile? @relation("RoomMaterial", fields: [materialProfileId], references: [id], onDelete: SetNull)
  hardwareProfileId     String?                 @map("hardware_profile_id")
  hardwareProfile       HardwareProfile?        @relation("RoomHardware", fields: [hardwareProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cabinets            Cabinet[]
  sceneAssetInstances SceneAssetInstance[]

  @@index([projectId])
  @@index([orgId])
  @@index([constructionProfileId])
  @@index([materialProfileId])
  @@index([hardwareProfileId])
  @@map("rooms")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. CABINETS
// A single cabinet unit within a room. Dimensions drive constraint propagation.
// ─────────────────────────────────────────────────────────────────────────────
model Cabinet {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  orgId      String   @map("org_id")
  // type: base | wall | tall | corner | island
  type       String   @db.VarChar(50)
  name       String   @db.VarChar(255)
  width      Decimal  @db.Decimal(10, 4)
  height     Decimal  @db.Decimal(10, 4)
  depth      Decimal  @db.Decimal(10, 4)
  posX       Decimal  @default(0) @map("pos_x") @db.Decimal(10, 4)
  posY       Decimal  @default(0) @map("pos_y") @db.Decimal(10, 4)
  posZ       Decimal  @default(0) @map("pos_z") @db.Decimal(10, 4)
  // Stores all parametric config: doorCount, shelfCount, hingeType, etc.
  parameters Json
  materialId String?  @map("material_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  room              Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  material          Material?          @relation(fields: [materialId], references: [id])
  parts             CabinetPart[]
  validationReports ValidationReport[]
  cutlists          Cutlist[]

  @@index([roomId])
  @@index([orgId])
  @@map("cabinets")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. CABINET PARTS
// Auto-computed from cabinet dimensions. Updated whenever parent cabinet changes.
// ─────────────────────────────────────────────────────────────────────────────
model CabinetPart {
  id        String   @id @default(cuid())
  cabinetId String   @map("cabinet_id")
  orgId     String   @map("org_id")
  // name: left_panel | right_panel | top_panel | bottom_panel | shelf | door | etc.
  name      String   @db.VarChar(100)
  partType  String   @map("part_type") @db.VarChar(100)
  width     Decimal  @db.Decimal(10, 4)
  height    Decimal  @db.Decimal(10, 4)
  thickness Decimal  @db.Decimal(10, 4)
  quantity  Int      @default(1)
  materialId String? @map("material_id")
  // grainDir: horizontal | vertical | none
  grainDir  String?  @map("grain_dir") @db.VarChar(20)
  // JSON: { top, bottom, left, right } booleans
  edgeBanding Json?  @map("edge_banding")
  // Machine-specific cut parameters, joinery specs, hardware boring positions
  cutParams     Json?    @map("cut_params")
  // Assembly group: carcass | face_frame | door | drawer | shelf
  assemblyGroup String?  @map("assembly_group") @db.VarChar(50)
  // Manual parts are user-added and survive geometry recomputes
  isManual      Boolean  @default(false) @map("is_manual")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cabinet  Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@index([cabinetId])
  @@index([orgId])
  @@map("cabinet_parts")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. MATERIALS
// Sheet goods catalogue per org (plywood, MDF, melamine, etc.)
// ─────────────────────────────────────────────────────────────────────────────
model Material {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  name          String   @db.VarChar(255)
  // type: plywood | mdf | solid_wood | melamine | laminate
  type          String   @db.VarChar(50)
  thickness     Decimal  @db.Decimal(10, 4)
  sheetWidth    Decimal  @map("sheet_width") @db.Decimal(10, 4)
  sheetHeight   Decimal  @map("sheet_height") @db.Decimal(10, 4)
  costPerSheet  Decimal  @map("cost_per_sheet") @db.Decimal(10, 2)
  supplier      String?  @db.VarChar(255)
  sku           String?  @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cabinets     Cabinet[]
  cabinetParts CabinetPart[]

  @@index([orgId])
  @@map("materials")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. HARDWARE
// Hardware catalogue per org (hinges, drawer slides, handles, etc.)
// ─────────────────────────────────────────────────────────────────────────────
model Hardware {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String   @db.VarChar(255)
  // type: hinge | drawer_slide | handle | screw | cam_lock | etc.
  type        String   @db.VarChar(100)
  sku         String?  @db.VarChar(100)
  supplier    String?  @db.VarChar(255)
  costPerUnit Decimal  @map("cost_per_unit") @db.Decimal(10, 4)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("hardware")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. CUTLISTS
// Generated cut list per cabinet — optimized sheet nesting + PDF/CSV export.
// ─────────────────────────────────────────────────────────────────────────────
model Cutlist {
  id          String   @id @default(cuid())
  cabinetId   String   @map("cabinet_id")
  orgId       String   @map("org_id")
  projectId   String   @map("project_id")
  version     Int      @default(1)
  // status: pending | optimized | exported
  status      String   @default("pending") @db.VarChar(50)
  pdfUrl      String?  @map("pdf_url") @db.Text
  csvUrl      String?  @map("csv_url") @db.Text
  // Array of { partName, width, height, thickness, qty, material, grainDir }
  parts       Json
  // Result from sheet nesting optimizer
  nestingData Json?    @map("nesting_data")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId])
  @@index([orgId])
  @@index([projectId])
  @@map("cutlists")
}

// ─────────────────────────────────────────────────────────────────────────────
// 11. CNC JOBS
// Async G-code / DXF generation jobs processed by cnc-service on AWS.
// ─────────────────────────────────────────────────────────────────────────────
model CncJob {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  projectId        String   @map("project_id")
  machineProfileId String   @map("machine_profile_id")
  // status: queued | processing | complete | failed
  status           String   @default("queued") @db.VarChar(50)
  gcodeUrl         String?  @map("gcode_url") @db.Text
  dxfUrl           String?  @map("dxf_url") @db.Text
  estimatedTime    Int?     @map("estimated_time")
  errorMessage     String?  @map("error_message") @db.Text
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  machineProfile MachineProfile @relation(fields: [machineProfileId], references: [id])

  @@index([orgId])
  @@index([projectId])
  @@map("cnc_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. MACHINE PROFILES
// CNC machine configuration — drives G-code post-processor selection.
// ─────────────────────────────────────────────────────────────────────────────
model MachineProfile {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  name          String   @db.VarChar(255)
  manufacturer  String   @db.VarChar(255)
  model         String   @db.VarChar(255)
  // type: cnc_router | panel_saw | edge_bander
  type          String   @db.VarChar(50)
  // Machine-specific settings: feed rates, tool diameters, offsets, spindle speed, etc.
  config        Json
  // Post-processor identifier, e.g. "holzher_dynestic_7507"
  postProcessor String   @map("post_processor") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cncJobs CncJob[]

  @@index([orgId])
  @@map("machine_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. VALIDATION REPORTS
// AI-generated reports from ai-service: collision detection, clearance checks, etc.
// ─────────────────────────────────────────────────────────────────────────────
model ValidationReport {
  id          String   @id @default(cuid())
  cabinetId   String   @map("cabinet_id")
  orgId       String   @map("org_id")
  projectId   String   @map("project_id")
  // status: pass | warning | fail
  status      String   @db.VarChar(20)
  // Array of { code, message, field, severity: "error" }
  errors      Json?
  // Array of { code, message, field, severity: "warning" }
  warnings    Json?
  aiModel     String?  @map("ai_model") @db.VarChar(100)
  rawResponse Json?    @map("raw_response")
  createdAt   DateTime @default(now()) @map("created_at")

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId])
  @@index([orgId])
  @@map("validation_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. REVISIONS
// Immutable snapshots of project state for undo/history/rollback.
// ─────────────────────────────────────────────────────────────────────────────
model Revision {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  version   Int
  // Full project JSON snapshot including all rooms, cabinets, and parts
  snapshot  Json
  message   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
  @@index([orgId])
  @@map("revisions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. PRODUCTION RUNS
// Tracks shop floor execution of an approved project.
// ─────────────────────────────────────────────────────────────────────────────
model ProductionRun {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  projectId   String    @map("project_id")
  // status: scheduled | in_progress | complete | cancelled
  status      String    @default("scheduled") @db.VarChar(50)
  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  notes       String?   @db.Text
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id])

  @@index([orgId])
  @@index([projectId])
  @@map("production_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 16. QUOTES
// Client-facing price quotes generated from the cut list + hardware BOM.
// ─────────────────────────────────────────────────────────────────────────────
model Quote {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  projectId  String    @map("project_id")
  userId     String    @map("user_id")
  // status: draft | sent | accepted | rejected | expired
  status     String    @default("draft") @db.VarChar(50)
  validUntil DateTime? @map("valid_until")
  // Array of { description, qty, unitPrice, total }
  lineItems  Json      @map("line_items")
  subtotal   Decimal   @db.Decimal(10, 2)
  // taxRate stored as decimal, e.g. 0.13 for 13%
  taxRate    Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount  Decimal   @map("tax_amount") @db.Decimal(10, 2)
  total      Decimal   @db.Decimal(10, 2)
  notes      String?   @db.Text
  pdfUrl     String?   @map("pdf_url") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([projectId])
  @@map("quotes")
}

// ─────────────────────────────────────────────────────────────────────────────
// 17. SCENE ASSET INSTANCES
// Per-room placement of a visualization / reference asset (furniture,
// appliance, plumbing fixture, decor). The catalog itself lives in shared
// code (`@woodcraft/shared` — `DEFAULT_SCENE_ASSET_CATALOG`); no DB table
// backs SceneAssetDefinition. Ownership pattern mirrors Cabinet exactly:
// `orgId` + `roomId` only, project is derived via `room.project`.
// See packages/db/MIGRATIONS.md and Slice 6 report for context.
// ─────────────────────────────────────────────────────────────────────────────
model SceneAssetInstance {
  id                String   @id @default(cuid())
  orgId             String   @map("org_id")
  roomId            String   @map("room_id")

  // Catalog reference — validated at API layer against
  // DEFAULT_SCENE_ASSET_CATALOG. No FK because the catalog lives in code.
  assetDefinitionId String   @map("asset_definition_id") @db.VarChar(191)

  // Position in millimeters, bottom-center anchor.
  posX              Decimal  @default(0) @map("pos_x") @db.Decimal(10, 4)
  posY              Decimal  @default(0) @map("pos_y") @db.Decimal(10, 4)
  posZ              Decimal  @default(0) @map("pos_z") @db.Decimal(10, 4)

  // Rotation in degrees.
  rotX              Decimal  @default(0) @map("rot_x") @db.Decimal(10, 4)
  rotY              Decimal  @default(0) @map("rot_y") @db.Decimal(10, 4)
  rotZ              Decimal  @default(0) @map("rot_z") @db.Decimal(10, 4)

  // Scale — persisted for future GLB normalization. Held at identity in
  // MVP; not user-editable through the create/update API.
  scaleX            Decimal  @default(1) @map("scale_x") @db.Decimal(10, 6)
  scaleY            Decimal  @default(1) @map("scale_y") @db.Decimal(10, 6)
  scaleZ            Decimal  @default(1) @map("scale_z") @db.Decimal(10, 6)

  visible           Boolean  @default(true)

  // Placement anchor. `placementMode = "free"` (the default) means
  // pos/rot are authoritative. `placementMode = "wall"` means the
  // wall_id + wall_local_* columns are authoritative and the renderer
  // derives the world transform via the wall-attachment resolver.
  // Legacy rows land as `placement_mode = "free"` + all wall_* NULL.
  // No FK on wall_id — walls live in `rooms.metadata.architecture` JSON.
  placementMode String  @default("free") @map("placement_mode") @db.VarChar(32)
  wallId        String? @map("wall_id") @db.VarChar(191)
  wallLocalX    Decimal? @map("wall_local_x") @db.Decimal(10, 4)
  wallLocalY    Decimal? @map("wall_local_y") @db.Decimal(10, 4)
  wallLocalZ    Decimal? @map("wall_local_z") @db.Decimal(10, 4)

  // Physical column is LONGTEXT (matches every other Json column on this
  // legacy DB — see packages/db/MIGRATIONS.md "Known drift alert").
  // Prisma Client reads/writes as JSON via its `Json` type.
  materialOverrides Json?    @map("material_overrides")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([orgId])
  @@map("scene_asset_instances")
}

// ─────────────────────────────────────────────────────────────────────────────
// 17b. SCENE ASSET DEFINITIONS
// Reusable catalog entries — the "types" that SceneAssetInstance references.
// Scope semantics:
//   · scope="system"  → visible to all orgs, orgId=null. Managed by a
//     platform admin (currently gated on role="owner"; the seam is
//     documented in apps/api/src/lib/scenePlatformAdmin.ts).
//   · scope="org"     → visible only to the owning org, orgId=<orgId>.
// SceneAssetInstance.assetDefinitionId still has no FK: an instance may
// reference a system definition, an org-scoped definition, or a legacy
// code-catalog id (during rollout). Availability is enforced at the API
// layer, matching the existing pattern.
//
// Nested metadata (placement, collision, model, provenance) uses the same
// safe JSON storage convention as every other Json column in the schema
// (physically LONGTEXT; see packages/db/MIGRATIONS.md "Known drift alert").
// ─────────────────────────────────────────────────────────────────────────────
model SceneAssetDefinition {
  id            String   @id @default(cuid())
  scope         String   @db.VarChar(32) // "system" | "org"
  orgId         String?  @map("org_id")

  // Human-readable + optional slug for legacy code-catalog compatibility.
  // When a SYSTEM asset is seeded from `DEFAULT_SCENE_ASSET_CATALOG`, the
  // catalog id lands here so existing SceneAssetInstance.assetDefinitionId
  // values keep resolving.
  slug          String?  @db.VarChar(191)
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  category      String   @db.VarChar(64)

  // Dimensions in mm (positive; validated at API layer).
  widthMm       Decimal  @map("width_mm") @db.Decimal(12, 4)
  heightMm      Decimal  @map("height_mm") @db.Decimal(12, 4)
  depthMm       Decimal  @map("depth_mm") @db.Decimal(12, 4)

  // Nested domain structures — persisted as JSON blobs.
  placement     Json?
  collision     Json?
  model         Json?
  provenance    Json?
  metadata      Json?

  // Denormalized for search / archive filters without JSON access.
  assetKey      String?  @map("asset_key") @db.VarChar(512)
  thumbnailKey  String?  @map("thumbnail_key") @db.VarChar(512)
  manufacturer  String?  @db.VarChar(255)
  sku           String?  @db.VarChar(191)
  tags          Json?    // string[]

  // Immutable-versioning family: rows with the same `family` and
  // increasing `revision` represent the version chain of one logical
  // asset. Current active row is picked by (family, revision desc,
  // active=true). Existing instances retain their assetDefinitionId
  // pointer so their geometry never silently changes.
  family        String   @db.VarChar(191)
  revision      Int      @default(1)

  active        Boolean  @default(true)
  systemManaged Boolean  @default(false) @map("system_managed")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([scope, orgId, active])
  @@index([family, revision])
  @@index([category])
  @@map("scene_asset_definitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// 18. INSTALLER FEEDBACK
// Field reports from installers — drives AI improvement loop.
// ─────────────────────────────────────────────────────────────────────────────
model InstallerFeedback {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  projectId   String    @map("project_id")
  cabinetId   String?   @map("cabinet_id")
  reportedBy  String    @map("reported_by") @db.VarChar(255)
  // severity: info | warning | error
  severity    String    @db.VarChar(20)
  // category: dimension_mismatch | missing_part | hardware_issue | other
  category    String    @db.VarChar(50)
  description String    @db.Text
  // Array of S3 URLs
  photoUrls   Json?     @map("photo_urls")
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([orgId])
  @@index([projectId])
  @@map("installer_feedback")
}

// ─────────────────────────────────────────────────────────────────────────────
// 19. PROFILE INHERITANCE — construction / material / hardware profiles.
//
// Phase 1: metadata + readiness only. compileUnit, CAD service, DXF,
// CNC, nesting are NOT wired to these profiles. Existing hardcoded
// compiler defaults remain authoritative.
//
// Verification model:
//   verificationStatus (row-level): "verified" | "partially_verified"
//     | "project_specific" | "unverified" — a summary; NOT authoritative
//     for individual fields.
//   fieldProvenance (per-field): FieldProvenanceMap JSON, mapping canonical
//     field name → { status, sourceRef }. The Inspector reads this to
//     display per-field verification.
//   verificationGaps (row-level): string[] of canonical gap keys the row
//     acknowledges as UNVERIFIED. Effective gap resolution: a mapped
//     field with a verified/non-null value at ANY scope closes its gap.
//   metadata.deferredCapabilities: array of VERIFIED-BUT-UNMODELED facts
//     (e.g. Hawkes drawer sub-part thicknesses; Klint Legrabox) — the
//     shop KNOWS these but the typed domain isn't built yet. Surfaced
//     under a separate PROFILE_CAPABILITY_DEFERRED readiness code.
//
// Physical Json storage is LONGTEXT per the schema-wide convention
// (packages/db/MIGRATIONS.md "Known drift alert").
// ─────────────────────────────────────────────────────────────────────────────

model ConstructionProfile {
  id                          String   @id @default(cuid())
  orgId                       String   @map("org_id")

  name                        String   @db.VarChar(120)
  description                 String?  @db.Text

  // Construction method (WHAT joinery family) — distinct from front overlay.
  constructionMethod          String?  @db.VarChar(20)  // "face_frame" | "frameless"

  // Front overlay mode (HOW fronts sit on the case) — orthogonal to method.
  frontOverlayMode            String?  @db.VarChar(24)  // "inset" | "partial_overlay" | "full_overlay"

  // Verified DIMENSIONAL construction facts (nullable — leave NULL until
  // shop-standard evidence).
  carcassThicknessMm          Decimal? @db.Decimal(6, 2)  // 19.05 = 3/4"
  drawerBoxThicknessMm        Decimal? @db.Decimal(6, 2)  // 15.00 = 15mm (Bibb)
  drawerBoxJoinery            String?  @db.VarChar(60)    // "dovetail"
  backThicknessMm             Decimal? @db.Decimal(6, 2)  // 6.35 = 1/4" (Bearnson build sheets)
  adjustableShelfThicknessMm  Decimal? @db.Decimal(6, 2)  // 19.05 = 3/4" (Bearnson build sheets)
  nailerThicknessMm           Decimal? @db.Decimal(6, 2)  // 19.05 = 3/4" (Bearnson build sheets)

  verificationStatus          String   @default("unverified") @db.VarChar(24)
  verificationGaps            Json?
  sourceRef                   String?  @db.VarChar(200)
  fieldProvenance             Json?

  // Freeform extras — NEVER a place to stash guessed manufacturing values.
  // Reserved for provenance notes, deferredCapabilities, etc.
  metadata                    Json?

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  org                         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgDefaults                 Organization[] @relation("OrgDefaultConstruction")
  projectRefs                 Project[]      @relation("ProjectConstruction")
  roomRefs                    Room[]         @relation("RoomConstruction")

  @@index([orgId])
  @@index([orgId, verificationStatus])
  @@map("construction_profiles")
}

model CabinetMaterialProfile {
  id                             String   @id @default(cuid())
  orgId                          String   @map("org_id")

  name                           String   @db.VarChar(120)
  description                    String?  @db.Text

  // Per-slot material spec text. Text (not FK) so a shop can express
  // policy like "Baltic birch OR solid maple". Spec strings EXCLUDE
  // thickness — thickness lives on ConstructionProfile.
  carcassMaterialSpec            String?  @db.VarChar(200)
  drawerBoxMaterialSpec          String?  @db.VarChar(200)
  faceFrameMaterialSpec          String?  @db.VarChar(200)
  doorMaterialSpec               String?  @db.VarChar(200)
  shelfMaterialSpec              String?  @db.VarChar(200)  // Fixed shelves — TBD
  backMaterialSpec               String?  @db.VarChar(200)  // "Maple Melamine G2S" (Bearnson)
  adjustableShelfMaterialSpec    String?  @db.VarChar(200)  // "Maple Melamine" (Bearnson)
  nailerMaterialSpec             String?  @db.VarChar(200)  // "Maple Melamine" (Bearnson)

  verificationStatus             String   @default("unverified") @db.VarChar(24)
  verificationGaps               Json?
  sourceRef                      String?  @db.VarChar(200)
  fieldProvenance                Json?
  metadata                       Json?

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  org                            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgDefaults                    Organization[] @relation("OrgDefaultMaterial")
  projectRefs                    Project[]      @relation("ProjectMaterial")
  roomRefs                       Room[]         @relation("RoomMaterial")

  @@index([orgId])
  @@index([orgId, verificationStatus])
  @@map("cabinet_material_profiles")
}

model HardwareProfile {
  id                             String   @id @default(cuid())
  orgId                          String   @map("org_id")

  name                           String   @db.VarChar(120)
  description                    String?  @db.Text

  // Verified minimum for Bearnson: manufacturer + soft-close from the
  // Approved Proposal. NO Clip Top / Movento / Tandem inferred.
  // Booleans are Boolean? — NULL = UNKNOWN, distinct from VERIFIED FALSE.
  hingeManufacturer              String?  @db.VarChar(60)
  hingeSoftClose                 Boolean?
  hingeSystem                    String?  @db.VarChar(120)

  drawerSlideManufacturer        String?  @db.VarChar(60)
  drawerSlideSoftClose           Boolean?
  drawerSlideSystem              String?  @db.VarChar(120)

  verificationStatus             String   @default("unverified") @db.VarChar(24)
  verificationGaps               Json?
  sourceRef                      String?  @db.VarChar(200)
  fieldProvenance                Json?
  metadata                       Json?

  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  org                            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgDefaults                    Organization[] @relation("OrgDefaultHardware")
  projectRefs                    Project[]      @relation("ProjectHardware")
  roomRefs                       Room[]         @relation("RoomHardware")

  @@index([orgId])
  @@index([orgId, verificationStatus])
  @@map("hardware_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 2 — CABINET FAMILY RULES / FRONT SYSTEMS / DRAWER SYSTEMS
//
// Family-dependent structural + geometric policy; front / drawer system
// libraries. Metadata + readiness only — Phase 2 does NOT wire these
// into compileUnit, CAD service, syncParts, DXF, CNC, sheet nesting,
// G-code, or calculateHardwareBom. Existing hardcoded compiler + BOM
// behavior remains authoritative.
//
// Assignments are stored in JSON metadata bags:
//   Organization.metadata.cabinetSystemAssignments
//   Project.metadata.cabinetSystemAssignments
//   Room.metadata.cabinetSystemAssignments
//   Cabinet.parameters { familyRuleId, frontSystemId, drawerSystemId, disableFamilyRule }
// This avoids 7 nullable FK columns for the per-CabinetType family map.
// ─────────────────────────────────────────────────────────────────────────────

model CabinetFamilyRule {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  cabinetType String   @db.VarChar(32)  // matches CabinetType enum in domain
  name        String   @db.VarChar(255)
  description String?  @db.Text

  // Structural presence — nullable so "unknown" is distinct from "false".
  hasToeKick        Boolean?
  hasBack           Boolean?
  hasNailer         Boolean?
  fixedShelfPolicy  String?  @db.VarChar(32)  // "none" | "structural" | "optional"
  cornerVariant     String?  @db.VarChar(24)  // "blind_left" | "blind_right" | "l_corner"

  // Family-dependent geometry / design policy. NEVER wired to compileUnit.
  toeHeightMm     Decimal? @db.Decimal(10, 4)
  toeRecessMm     Decimal? @db.Decimal(10, 4)
  topRevealMm     Decimal? @db.Decimal(10, 4)
  bottomRevealMm  Decimal? @db.Decimal(10, 4)
  topScribeMm     Decimal? @db.Decimal(10, 4)
  bottomScribeMm  Decimal? @db.Decimal(10, 4)

  verificationStatus String   @default("unverified") @db.VarChar(24)
  verificationGaps   Json?
  sourceRef          String?  @db.VarChar(200)
  fieldProvenance    Json?
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, cabinetType])
  @@map("cabinet_family_rules")
}

model FrontSystem {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String   @db.VarChar(255)
  description String?  @db.Text

  // Movement kind — orthogonal to role/glassFlag.
  // "hinged_single" | "hinged_double" | "bifold" | "pocket" | "open" | "fixed_panel"
  kind      String   @db.VarChar(24)
  // "cabinet_front" | "appliance_panel"
  role      String   @db.VarChar(24)
  glassFlag Boolean  @default(false)

  verificationStatus String   @default("unverified") @db.VarChar(24)
  verificationGaps   Json?
  sourceRef          String?  @db.VarChar(200)
  fieldProvenance    Json?
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, kind])
  @@map("front_systems")
}

model DrawerSystem {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String   @db.VarChar(255)
  description String?  @db.Text

  // "traditional" | "proprietary" — controls which subset of fields is
  // populated. Enforcement of the discriminated shape happens in the
  // Zod schemas (CREATE full + PATCH candidate-state validation).
  kind String @db.VarChar(24)

  // Traditional fields — null when kind = "proprietary".
  boxSideThicknessMm     Decimal? @db.Decimal(10, 4)
  boxBottomThicknessMm   Decimal? @db.Decimal(10, 4)
  boxBackThicknessMm     Decimal? @db.Decimal(10, 4)
  boxSubFrontThicknessMm Decimal? @db.Decimal(10, 4)
  boxJoinery             String?  @db.VarChar(32)   // "dovetail" | "dowel" | "confirmat" | "rabbet_dado" | "butt_screw"

  // Proprietary fields — null when kind = "traditional".
  proprietaryFamily String? @db.VarChar(64)

  verificationStatus String   @default("unverified") @db.VarChar(24)
  verificationGaps   Json?
  sourceRef          String?  @db.VarChar(200)
  fieldProvenance    Json?
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, kind])
  @@map("drawer_systems")
}
